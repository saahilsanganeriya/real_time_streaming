---
config:
  theme: neutral
---
erDiagram
direction lr
    JSON_PAYLOAD {
        object metadata "Root level metadata object"
        object message "Root level message object"
    }
    METADATA_OBJECT {
        string messageId "SNS message identifier"
        string sns_timestamp "SNS message timestamp ISO-8601"
        string lambda_timestamp "Lambda processing timestamp"
        string topicArn "SNS topic ARN"
        string subject "SNS subject (usually null)"
        object attributes "Nested attributes object"
    }
    ATTRIBUTES_OBJECT {
        object EventType "Type=String, Value=OpportunityCreated/Updated/Deleted"
        object FieldsChanged "Type=String, Value=JSON array of changed fields"
        object Country "Type=String, Value=country name"
        object OpportunityType "Type=String, Value=COVER/REGULAR/etc"
    }
    MESSAGE_OBJECT {
        string entityId "Entity identifier"
        object event "Event details object"
        string eventTime "Business event timestamp ISO-8601"
        number sequenceNumber "Event sequence number"
    }
    EVENT_OBJECT {
        string serializationKey "Event type key"
        object serializedData "Event payload object"
    }
    SERIALIZED_DATA_OBJECT {
        object oldOpp "Previous opportunity state (for updates)"
        object newOpp "Current opportunity state"
    }
    OPPORTUNITY_OBJECT {
        string id "Opportunity ID"
        object timeRange "Shift time range object"
        string timezone "Timezone string"
        string locationId "Location identifier" 
        string country "Country name"
        string workgroup "Work group name"
        string source "Opportunity source"
        string type "Opportunity type"
        string claimStartsAt "Claim window start ISO-8601"
        string claimEndsAt "Claim window end ISO-8601"
        string createdAt "Created timestamp ISO-8601"
        string createdBy "Creator identifier"
        string lastUpdatedAt "Last update timestamp ISO-8601"
        string lastUpdatedBy "Last updater identifier"
        string lastActionTaken "Last action performed"
        string batchId "Batch identifier (nullable)"
        number totalHeadCount "Total positions available"
        array acceptedAssociateIds "Array of accepted associate IDs"
        string dropPenaltyStartsAt "Drop penalty start ISO-8601"
        string dropEndsAt "Drop window end ISO-8601"
        object shiftMatchRequestDetails "Key-value map of match details"
        array payModifiers "Array of pay modifier strings"
    }
    TIME_RANGE_OBJECT {
        string start "Shift start time ISO-8601"
        string end "Shift end time ISO-8601"
    }
    ShiftOpportunityEvent {
        string messageId "FROM metadata.messageId"
        instant snsTimestamp "FROM metadata.sns_timestamp"
        instant lambdaTimestamp "FROM metadata.lambda_timestamp"
        string topicArn "FROM metadata.topicArn"
        string eventType "FROM metadata.attributes EventType Value"
        string country "FROM metadata.attributes Country Value"
        string opportunityType "FROM metadata.attributes OpportunityType Value"
        string fieldsChanged "FROM metadata.attributes FieldsChanged Value"
        string entityId "FROM message.entityId"
        string serializationKey "FROM message.event.serializationKey"
        instant srcTimestamp "FROM message.eventTime"
        long sequenceNumber "FROM message.sequenceNumber"
        string opportunityId "COALESCE newOpp.id, oldOpp.id"
        string locationId "COALESCE newOpp.locationId, oldOpp.locationId"
        string workgroup "COALESCE newOpp.workgroup, oldOpp.workgroup"
        string source "COALESCE newOpp.source, oldOpp.source"
        string timezone "COALESCE newOpp.timezone, oldOpp.timezone"
        instant shiftStartTime "COALESCE newOpp.timeRange.start, oldOpp.timeRange.start"
        instant shiftEndTime "COALESCE newOpp.timeRange.end, oldOpp.timeRange.end"
        instant claimStartsAt "COALESCE newOpp.claimStartsAt, oldOpp.claimStartsAt"
        instant claimEndsAt "COALESCE newOpp.claimEndsAt, oldOpp.claimEndsAt"
        instant createdAt "COALESCE newOpp.createdAt, oldOpp.createdAt"
        string createdBy "COALESCE newOpp.createdBy, oldOpp.createdBy"
        string lastUpdatedBy "Current state: newOpp for created/updated, oldOpp for deleted"
        string lastActionTaken "Current state action"
        integer totalHeadCount "Current state headcount"
        array acceptedAssociateIds "Current state associate assignments"
        instant previousSrcTimestamp "FROM oldOpp.lastUpdatedAt (for change tracking)"
        string previousLastUpdatedBy "FROM oldOpp.lastUpdatedBy"
        string previousLastActionTaken "FROM oldOpp.lastActionTaken"
        integer previousTotalHeadCount "FROM oldOpp.totalHeadCount"
        array previousAcceptedAssociateIds "FROM oldOpp.acceptedAssociateIds"
        string batchId "FROM newOpp.batchId"
        instant dropPenaltyStartsAt "FROM newOpp.dropPenaltyStartsAt"
        instant dropEndsAt "FROM newOpp.dropEndsAt"
        string fillStatus "COMPUTED based on totalHeadCount vs acceptedAssociateIds"
        string claimStatus "COMPUTED based on claim time windows vs current time"
        boolean headCountChanged "COMPUTED change detection flag"
        boolean acceptedAssociatesChanged "COMPUTED change detection flag"
    }
    shift_opportunity_current {
        string opportunity_id PK "PRIMARY KEY for upsert operations"
        string event_type "Latest event type"
        string country "Geographic region"
        string opportunity_type "Business category"
        string location_id "Physical location"
        string workgroup "Organizational unit"
        string source "Source system"
        string timezone "Shift timezone"
        instant shift_start_time "Work period start"
        instant shift_end_time "Work period end"
        instant claim_starts_at "Claim window start"
        instant claim_ends_at "Claim window end"
        instant created_at "Initial creation time"
        string created_by "Original creator"
        instant src_timestamp "Source system timestamp (for conditional updates)"
        string last_updated_by "Most recent modifier"
        string last_action_taken "Latest action"
        integer total_head_count "Required positions"
        array accepted_associate_ids "Currently assigned associates"
        string batch_id "Batch processing ID"
        instant drop_penalty_starts_at "Drop penalty start"
        instant drop_ends_at "Drop period end"
        string fill_status "OPEN/PARTIALLY_FILLED/FILLED"
        string claim_status "NOT_STARTED/ACTIVE/EXPIRED"
        instant sns_timestamp "SNS publication time"
        instant flink_timestamp "Flink processing completion time"
        long end_to_end_latency_ms "Total system latency metric"
        long sns_to_flink_latency_ms "Real-time processing latency metric"
    }
    shift_opportunity_events_log {
        string message_id "SNS message ID for correlation"
        string opportunity_id "Business entity ID"
        string event_type "Event classification"
        string country "Geographic context"
        string opportunity_type "Business category"
        string fields_changed "Audit trail of changed fields"
        string entity_id "Entity identifier"
        string serialization_key "Event serialization type"
        instant src_timestamp "Source system event time"
        long sequence_number "Event ordering number"
        string location_id "Physical location"
        string workgroup "Organizational context"
        string source "Originating system"
        string timezone "Temporal context"
        instant shift_start_time "Work start time"
        instant shift_end_time "Work end time"
        instant claim_starts_at "Claim period start"
        instant claim_ends_at "Claim period end"
        instant created_at "Original creation"
        string created_by "Original creator"
        string last_updated_by "Current modifier"
        string last_action_taken "Current action"
        integer total_head_count "Current headcount"
        array accepted_associate_ids "Current assignments"
        instant previous_src_timestamp "Previous state timestamp"
        string previous_last_updated_by "Previous modifier"
        string previous_last_action_taken "Previous action"
        integer previous_total_head_count "Previous headcount"
        array previous_accepted_associate_ids "Previous assignments"
        string batch_id "Batch identifier"
        instant drop_penalty_starts_at "Drop penalty timing"
        instant drop_ends_at "Drop period end"
        string fill_status "Computed fill state"
        string claim_status "Computed claim state"
        boolean head_count_changed "Change detection flag"
        boolean accepted_associates_changed "Assignment change flag"
        instant sns_timestamp "Transport timestamp"
        instant flink_timestamp "Processing timestamp"
        string topic_arn "Source topic"
        long end_to_end_latency_ms "Performance metric"
        long sns_to_flink_latency_ms "Processing latency"
    }
    shift_opportunity_associates {
        string document_id PK "Composite key: opportunity_id + # + associate_id"
        string event_type "Parent event type"
        string opportunity_id "Parent opportunity identifier"
        string associate_id "Individual associate identifier"
        string opportunity_type "Business category"
        boolean is_deleted "Lifecycle flag for record cleanup"
        string country "Geographic classification"
        string location_id "Physical location"
        string workgroup "Organizational unit"
        string source "Source system"
        string timezone "Temporal context"
        string batch_id "Batch processing identifier"
        instant claim_starts_at "Claim window start"
        instant claim_ends_at "Claim window end"
        string claim_status "Claim state"
        instant shift_start_time "Work start time"
        instant shift_end_time "Work end time"
        instant created_at "Opportunity creation"
        string created_by "Opportunity creator"
        string last_updated_by "Most recent modifier"
        string last_action_taken "Latest action"
        double total_head_count "Total positions (converted to Double for analytics)"
        string fill_status "Fill state"
        instant drop_penalty_starts_at "Drop penalty start"
        instant drop_ends_at "Drop period end"
        instant src_timestamp "Source timestamp for conditional updates"
        instant sns_timestamp "SNS timestamp"
        instant lambda_timestamp "Lambda timestamp"
        instant flink_timestamp "Flink processing timestamp"
        long end_to_end_latency_ms "Total latency metric"
        long sns_to_flink_latency_ms "Processing latency metric"
    }
    JSON_PAYLOAD ||--|| METADATA_OBJECT : "contains metadata"
    JSON_PAYLOAD ||--|| MESSAGE_OBJECT : "contains message"
    METADATA_OBJECT ||--|| ATTRIBUTES_OBJECT : "contains attributes"
    MESSAGE_OBJECT ||--|| EVENT_OBJECT : "contains event"
    EVENT_OBJECT ||--|| SERIALIZED_DATA_OBJECT : "contains serializedData"
    SERIALIZED_DATA_OBJECT ||--o| OPPORTUNITY_OBJECT : "contains oldOpp (nullable)"
    SERIALIZED_DATA_OBJECT ||--|| OPPORTUNITY_OBJECT : "contains newOpp"
    OPPORTUNITY_OBJECT ||--|| TIME_RANGE_OBJECT : "contains timeRange"
    JSON_PAYLOAD ||--|| ShiftOpportunityEvent : "Java deserialization with COALESCE logic"
    ShiftOpportunityEvent ||--|| shift_opportunity_current : "map() transformation to current state"
    ShiftOpportunityEvent ||--|| shift_opportunity_events_log : "map() transformation to audit log"
    ShiftOpportunityEvent ||--o{ shift_opportunity_associates : "flatMap() one-to-many transformation"
